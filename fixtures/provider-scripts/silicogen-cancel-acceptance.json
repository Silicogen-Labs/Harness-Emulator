{
  "version": 1,
  "rules": [
    {
      "ruleId": "acceptance-delayed-main",
      "match": { "model": "fixture-main", "stream": true },
      "responses": [{ "delayMs": 20000, "content": "This delayed response should be cancelled from the TUI.", "finishReason": "stop" }]
    },
    {
      "ruleId": "acceptance-title",
      "match": { "model": "fixture-title", "stream": true },
      "responses": [{ "content": "Cancellation acceptance", "finishReason": "stop" }]
    },
    {
      "ruleId": "acceptance-summary",
      "match": { "model": "fixture-summary", "stream": true },
      "responses": [{ "content": "Cancellation scenario.", "finishReason": "stop" }]
    },
    {
      "ruleId": "acceptance-catchup",
      "match": { "model": "fixture-recap", "stream": true },
      "responses": [{ "content": "{\"summary\":\"Cancellation scenario.\",\"next_action\":null}", "finishReason": "stop" }]
    },
    {
      "ruleId": "acceptance-turn-recap",
      "match": { "model": "fixture-recap-turn", "stream": true },
      "responses": [{ "content": "{\"summary\":\"Cancelled delayed turn.\",\"next_action\":null}", "finishReason": "stop" }]
    }
  ]
}
