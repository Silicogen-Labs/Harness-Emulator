{
  "version": 1,
  "rules": [
    {
      "ruleId": "acceptance-main",
      "match": { "model": "fixture-main", "stream": true },
      "responses": [{ "content": "The conversation turn completed.", "finishReason": "stop" }]
    },
    {
      "ruleId": "acceptance-title",
      "match": { "model": "fixture-title", "stream": true },
      "responses": [{ "content": "Recap timeout acceptance", "finishReason": "stop" }]
    },
    {
      "ruleId": "acceptance-summary",
      "match": { "model": "fixture-summary", "stream": true },
      "responses": [{ "content": "The conversation turn completed.", "finishReason": "stop" }]
    },
    {
      "ruleId": "acceptance-catchup-timeout",
      "match": { "model": "fixture-recap", "stream": true },
      "responses": [{ "delayMs": 35000, "content": "{\"summary\":\"This response arrives after the recap deadline.\",\"next_action\":null}", "finishReason": "stop" }]
    },
    {
      "ruleId": "acceptance-turn-recap",
      "match": { "model": "fixture-recap-turn", "stream": true },
      "responses": [{ "content": "{\"summary\":\"Turn completed before explicit recap.\",\"next_action\":null}", "finishReason": "stop" }]
    }
  ]
}
