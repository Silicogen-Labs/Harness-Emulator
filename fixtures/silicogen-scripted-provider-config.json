        "fixture-title": { "id": "fixture-title", "name": "Synthetic title helper", "release_date": "2026-10-18", "limit": { "context": 262144, "output": 256 }, "attachment": false, "reasoning": false, "temperature": true, "tool_call": false, "modalities": { "input": ["text"], "output": ["text"] }, "options": {} },
        "fixture-summary": { "id": "fixture-summary", "name": "Synthetic summary helper", "release_date": "2026-10-18", "limit": { "context": 262144, "output": 512 }, "attachment": false, "reasoning": false, "temperature": true, "tool_call": false, "modalities": { "input": ["text"], "output": ["text"] }, "options": {} },
        "fixture-recap": { "id": "fixture-recap", "name": "Synthetic recap helper", "release_date": "2026-10-18", "limit": { "context": 262144, "output": 512 }, "attachment": false, "reasoning": false, "temperature": true, "tool_call": false, "modalities": { "input": ["text"], "output": ["text"] }, "options": {} },
        "fixture-recap-turn": { "id": "fixture-recap-turn", "name": "Synthetic turn recap helper", "release_date": "2026-10-18", "limit": { "context": 262144, "output": 512 }, "attachment": false, "reasoning": false, "temperature": true, "tool_call": false, "modalities": { "input": ["text"], "output": ["text"] }, "options": {} }
      }
    }
  },
  "agent": {
    "title": { "model": "emulation-fixture/fixture-title" },
    "summary": { "model": "emulation-fixture/fixture-summary" },
    "recap": { "model": "emulation-fixture/fixture-recap" },
    "recap_turn": { "model": "emulation-fixture/fixture-recap-turn" }
  }
}
